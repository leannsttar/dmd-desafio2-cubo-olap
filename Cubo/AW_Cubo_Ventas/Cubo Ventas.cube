  <Source dwd:design-time-name="43bc6faa-a1be-4596-820a-e1f96a7a554b">
    <DataSourceViewID>DSV_Ventas</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="bdb058ca-3604-4b76-bf74-0b3be6e2644b">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;

CREATE MEMBER CURRENTCUBE.[Measures].[Ganancia Internet]
 AS [Measures].[Sales Amount] - [Measures].[Total Product Cost],
FORMAT_STRING = "$#,##0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Fact Internet Sales';

CREATE MEMBER CURRENTCUBE.[Measures].[Ganancia Reseller]
 AS [Measures].[Sales Amount - Fact Reseller Sales] - [Measures].[Total Product Cost - Fact Reseller Sales],
FORMAT_STRING = "$#,##0.00", VISIBLE = 1, ASSOCIATED_MEASURE_GROUP = 'Fact Reseller Sales';

CREATE MEMBER CURRENTCUBE.[Measures].[Ventas Totales]
 AS [Measures].[Sales Amount] + [Measures].[Sales Amount - Fact Reseller Sales],
FORMAT_STRING = "$#,##0.00", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Ganancia Total]
 AS [Measures].[Ganancia Internet] + [Measures].[Ganancia Reseller],
FORMAT_STRING = "$#,##0.00", VISIBLE = 1;

CREATE MEMBER CURRENTCUBE.[Measures].[Margen %]
 AS IIF([Measures].[Ventas Totales] = 0, NULL,
        [Measures].[Ganancia Total] / [Measures].[Ventas Totales]),
FORMAT_STRING = "Percent", VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>